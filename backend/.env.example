# ─────────────────────────────────────────────────────────────
# Johnnie Boy's Foundation — Backend Environment Variables
# Copy to .env for local dev. On Render, set these in:
#   Dashboard → Your Service → Environment
# ─────────────────────────────────────────────────────────────

# ── Database (Neon) ───────────────────────────────────────────
# DATABASE_URL  → Neon pooled connection string (use for the running app)
# DIRECT_URL    → Neon unpooled/direct connection string (used by prisma migrate deploy)
#
# Both are available in: Neon Dashboard → your project → Connection Details
# Select "Pooled" or "Direct" from the dropdown and copy the full string.
# Add ?sslmode=require to both.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────
# Use a long random string in production (Render can auto-generate this)
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Admin seed credentials ────────────────────────────────────
# Used only by: npm run db:seed
ADMIN_EMAIL="admin@johnnieboysfoundation.org"
ADMIN_PASSWORD="change-this-strong-password"

# ── Cloudflare R2 (image/video uploads) ──────────────────────
# R2_ACCOUNT_ID   → Cloudflare Dashboard → R2 → Overview (right-hand side)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY → R2 → Manage R2 API tokens
# R2_BUCKET_NAME  → the name of your R2 bucket
# R2_PUBLIC_URL   → your bucket's public domain, e.g. https://pub-xxx.r2.dev
#                   or a custom domain like https://assets.johnnieboysfoundation.org
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Paystack (donations) ──────────────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_live_your-paystack-secret-key"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# ── Email / SMTP ──────────────────────────────────────────────
# Gmail: enable 2FA, then create an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Johnnie Boy's Foundation <noreply@johnnieboysfoundation.org>"

# ── CORS ──────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
# Comma-separate multiple origins: https://example.com,https://www.example.com
FRONTEND_URL="https://your-app.vercel.app"

# ── Server ────────────────────────────────────────────────────
# Render sets PORT automatically — leave as 5000 locally or omit
PORT="5000"
NODE_ENV="production"
